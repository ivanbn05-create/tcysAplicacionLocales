DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.30
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8000
WAITRESS_THREADS=8
WAITRESS_CONNECTION_LIMIT=100
WAITRESS_CHANNEL_TIMEOUT=30
WAITRESS_CLEANUP_INTERVAL=10
# Sólo para un local que acepte conscientemente HTTP sin cifrar en su LAN.
ALLOW_INSECURE_HTTP_LAN=false
# Activa sólo detrás de un proxy HTTPS; configura además WAITRESS_TRUSTED_PROXY.
DJANGO_HTTPS=false
DJANGO_HSTS_SECONDS=31536000
WAITRESS_TRUSTED_PROXY=
DB_ENGINE=sqlite
SQLITE_PATH=runtime/db.sqlite3
POSTGRES_DB=tocayos
POSTGRES_USER=tocayos
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Production 1.0: la identidad viene del recibo HTTPS de Central, no de selección local.
SUCURSAL_CLAVE=
# Usada por el aprovisionamiento Docker; el instalador Windows la recibe como parámetro.
SUCURSAL_NOMBRE=
# Production 1.0 exige UUID Central exacto. Vacío sólo para laboratorios legados.
SUCURSAL_ID=
POS_TICKET_LOCK_LEASE_SECONDS=15
# La plantilla falla segura. Para habilitar tcp, define cada host durante el alta local.
PRINT_BACKEND=archivo
PRINT_SYNC=false
PRINT_PROCESSING_TIMEOUT_SECONDS=300
PRINTER_CAJA_HOST=
PRINTER_COCINA_HOST=
PRINTER_BARRA_HOST=
PRINTER_PORT=9100
PRINTER_TIMEOUT=5
PRINT_PREVIEW_RETENTION_DAYS=7
# Activa sólo después de crear y verificar el rol pos_local_reader.
PEDIDOS_SUCURSALES_FUENTE=desactivada
PEDIDOS_SUCURSALES_AUTO_SYNC=false
PEDIDOS_SUCURSALES_SYNC_SECONDS=300
PEDIDOS_SUCURSALES_MAX_PEDIDOS=500
PEDIDOS_SUCURSALES_HORA_INICIO=06:00
PEDIDOS_SUCURSALES_HORA_FIN=17:35
PEDIDOS_SUCURSALES_DB_HOST=
PEDIDOS_SUCURSALES_DB_PORT=5432
PEDIDOS_SUCURSALES_DB_NAME=postgres
PEDIDOS_SUCURSALES_DB_USER=
PEDIDOS_SUCURSALES_DB_PASSWORD=
PEDIDOS_SUCURSALES_DB_SSLMODE=verify-full
PEDIDOS_SUCURSALES_DB_SSLROOTCERT=certs/prod-ca-2021.crt

# Transporte API v2 candidato. No activar hasta aprobar el mapeo POS <-> SucursalCliente.
PEDIDOS_API_BASE_URL=
PEDIDOS_API_ENDPOINT=/api/v2/pos/pedidos/
PEDIDOS_API_TOKEN=
PEDIDOS_API_CA_BUNDLE=
PEDIDOS_API_SUCURSAL_IDS=
PEDIDOS_API_PAGE_SIZE=100
PEDIDOS_API_CONNECT_TIMEOUT_SECONDS=5
PEDIDOS_API_READ_TIMEOUT_SECONDS=15
PEDIDOS_API_MAX_RESPONSE_BYTES=1048576
PEDIDOS_API_MAX_RETRIES=2

# Backend Central v2 candidato. Rutas apagadas hasta conciliacion y E2E autorizado.
CENTRAL_API_BASE_URL=
CENTRAL_BRANCH_ID=
CENTRAL_BRANCH_CODE=
CENTRAL_POS_INSTANCE_ID=
CENTRAL_EDGE_LABEL=
CENTRAL_ENROLLMENT_REQUEST_ID=
CENTRAL_INGEST_CREDENTIAL_ID=
CENTRAL_CATALOG_CREDENTIAL_ID=
CENTRAL_INGEST_TOKEN=
CENTRAL_CATALOG_TOKEN=
CENTRAL_API_CA_BUNDLE=
CENTRAL_ENABLE_SALES_V2=false
CENTRAL_ENABLE_CUSTOMERS_V2=false
CENTRAL_ENABLE_CATALOG_DISTRIBUTION_V2=false
CENTRAL_ENABLE_CATALOG_DISTRIBUTION_V3=false
CENTRAL_CONNECT_TIMEOUT_SECONDS=5
CENTRAL_READ_TIMEOUT_SECONDS=15
CENTRAL_MAX_RESPONSE_BYTES=1048576
CENTRAL_SYNC_INTERVAL_SECONDS=300

# Consolidación mensual Edge -> VPS. URL y token se configuran juntos.
VPS_CONSOLIDACION_URL=
VPS_CONSOLIDACION_TOKEN=
VPS_CONSOLIDACION_TIMEOUT=10
