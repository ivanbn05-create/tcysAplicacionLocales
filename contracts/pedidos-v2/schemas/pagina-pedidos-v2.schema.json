{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.lostocayos.invalid/pedidos-v2/pagina-pedidos-v2.schema.json",
  "title": "Página estricta de pedidos confirmados para POS v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "request_id", "data", "page"],
  "properties": {
    "version": {"const": "v2"},
    "request_id": {"$ref": "#/$defs/requestId"},
    "data": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/pedido"}
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_more", "limit", "next_cursor", "returned"],
      "properties": {
        "has_more": {"type": "boolean"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "next_cursor": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 2048},
            {"type": "null"}
          ]
        },
        "returned": {"type": "integer", "minimum": 0, "maximum": 500}
      }
    }
  },
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "uuidCanonico": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cantidadPositiva": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?=.*[1-9])0*[0-9]{1,3}(?:\\.[0-9]{1,3})?$"
    },
    "precioNoNegativo": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^0*[0-9]{1,8}(?:\\.[0-9]{1,2})?$"
    },
    "totalNoNegativo": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^0*[0-9]{1,18}(?:\\.[0-9]{1,2})?$"
    },
    "producto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "nombre_ticket", "unidad_medida", "unidad_abreviatura", "cantidad_por_precio"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "nombre": {"type": "string", "minLength": 1, "maxLength": 80},
        "nombre_ticket": {"type": "string", "maxLength": 24},
        "unidad_medida": {"type": "string", "minLength": 1, "maxLength": 40},
        "unidad_abreviatura": {"type": "string", "minLength": 1, "maxLength": 8},
        "cantidad_por_precio": {"$ref": "#/$defs/cantidadPositiva"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pedido_id", "producto", "cantidad", "precio_unitario", "subtotal"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "pedido_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "producto": {"$ref": "#/$defs/producto"},
        "cantidad": {"$ref": "#/$defs/cantidadPositiva"},
        "precio_unitario": {"$ref": "#/$defs/precioNoNegativo"},
        "subtotal": {"$ref": "#/$defs/totalNoNegativo"}
      }
    },
    "pedido": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "codigo_publico", "fecha_confirmacion", "total", "sucursal", "items"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "codigo_publico": {
          "allOf": [{"$ref": "#/$defs/uuidCanonico"}],
          "description": "UUID durable del Pedido; no pertenece a SucursalCliente."
        },
        "fecha_confirmacion": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "total": {"$ref": "#/$defs/totalNoNegativo"},
        "sucursal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "nombre", "tipo"],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "description": "SucursalCliente.id; identidad remota aprobada explícitamente."
            },
            "nombre": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Sólo display; nunca identidad."
            },
            "tipo": {"const": "sucursal"}
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/item"}
        }
      }
    }
  },
  "x-semantic-rules": [
    "request_id debe coincidir con X-Request-ID",
    "page.limit debe coincidir con el límite solicitado",
    "page.returned debe ser igual a len(data)",
    "has_more=true requiere data no vacía y next_cursor no nulo",
    "has_more=false requiere next_cursor nulo",
    "pedidos se ordenan estrictamente por (fecha_confirmacion, id)",
    "id y codigo_publico de Pedido no se repiten en una página",
    "item.pedido_id debe coincidir con pedido.id",
    "subtotal y total deben coincidir con los cálculos decimales"
  ]
}
