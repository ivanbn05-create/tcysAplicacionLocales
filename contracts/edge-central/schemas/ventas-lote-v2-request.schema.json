{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.lostocayos.invalid/edge-central/ventas-lote-v2-request.schema.json",
  "title": "Lote inmutable de eventos de venta v2 propuesto",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_contrato",
    "lote_id",
    "sucursal",
    "creado_en",
    "conteo",
    "eventos",
    "contenido_sha256"
  ],
  "properties": {
    "version_contrato": {
      "const": 2
    },
    "lote_id": {
      "type": "string",
      "format": "uuid"
    },
    "sucursal": {
      "$ref": "#/$defs/sucursal"
    },
    "creado_en": {
      "type": "string",
      "format": "date-time"
    },
    "conteo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "eventos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evento"
      }
    },
    "contenido_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "sucursal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clave"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "clave": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      }
    },
    "evento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evento_id",
        "tipo",
        "venta_id",
        "version_agregado",
        "ocurrido_en",
        "venta"
      ],
      "properties": {
        "evento_id": {
          "type": "string",
          "format": "uuid"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "venta.cerrada",
            "venta.cancelada",
            "venta.ajustada"
          ]
        },
        "venta_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_agregado": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "ocurrido_en": {
          "type": "string",
          "format": "date-time"
        },
        "venta": {
          "$ref": "#/$defs/venta"
        }
      }
    },
    "venta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serie_folio",
        "folio",
        "canal",
        "estado",
        "cliente_id",
        "creado_en",
        "cerrado_en",
        "moneda",
        "subtotal",
        "descuento_porcentaje",
        "total",
        "forma_pago",
        "partidas"
      ],
      "properties": {
        "serie_folio": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "folio": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "canal": {
          "type": "string",
          "enum": [
            "comedor",
            "llevar",
            "domicilio",
            "recoger",
            "sucursales"
          ]
        },
        "estado": {
          "type": "string",
          "enum": [
            "pagado",
            "cancelado"
          ]
        },
        "cliente_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "creado_en": {
          "type": "string",
          "format": "date-time"
        },
        "cerrado_en": {
          "type": "string",
          "format": "date-time"
        },
        "moneda": {
          "const": "MXN"
        },
        "subtotal": {
          "$ref": "#/$defs/importe"
        },
        "descuento_porcentaje": {
          "type": "string",
          "pattern": "^[0-9]{1,3}\\.[0-9]{2}$"
        },
        "total": {
          "$ref": "#/$defs/importe"
        },
        "forma_pago": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "efectivo",
            "tarjeta",
            null
          ]
        },
        "partidas": {
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/partida"
          }
        }
      }
    },
    "partida": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origen",
        "producto_id",
        "codigo",
        "nombre_cobrado",
        "nombre_corto_cobrado",
        "cantidad",
        "cantidad_por_precio",
        "unidad",
        "precio_unitario",
        "importe"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "origen": {
          "type": "string",
          "enum": [
            "menu",
            "sucursal",
            "personalizado"
          ]
        },
        "producto_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "codigo": {
          "type": "string",
          "maxLength": 30
        },
        "nombre_cobrado": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "nombre_corto_cobrado": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "cantidad": {
          "type": "string",
          "pattern": "^[0-9]{1,8}\\.[0-9]{3}$"
        },
        "cantidad_por_precio": {
          "type": "string",
          "pattern": "^[0-9]{1,8}\\.[0-9]{3}$"
        },
        "unidad": {
          "type": "string",
          "maxLength": 8
        },
        "precio_unitario": {
          "$ref": "#/$defs/importe"
        },
        "importe": {
          "$ref": "#/$defs/importe"
        }
      }
    },
    "importe": {
      "type": "string",
      "pattern": "^-?[0-9]{1,12}\\.[0-9]{2}$"
    }
  }
}
