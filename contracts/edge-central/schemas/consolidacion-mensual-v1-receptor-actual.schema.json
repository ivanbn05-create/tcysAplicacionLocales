{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.lostocayos.invalid/edge-central/consolidacion-mensual-v1-receptor-actual.schema.json",
  "title": "Aceptacion observada del receptor central mensual v1",
  "description": "Compatibilidad exacta documentada del commit a931c46. El perfil emisor POS mas estricto permanece en consolidacion-mensual-v1-request.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version_contrato", "idempotencia", "sucursal", "periodo", "totales"],
  "properties": {
    "version_contrato": {"const": 1},
    "idempotencia": {"type": "string", "format": "uuid"},
    "sucursal": {
      "type": "object",
      "required": ["id", "clave", "nombre"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "clave": {"type": "string", "maxLength": 64},
        "nombre": {"type": "string", "maxLength": 180}
      },
      "additionalProperties": true
    },
    "periodo": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-01$"
    },
    "totales": {
      "type": "object",
      "required": ["periodo", "cortes", "ventas", "resultado_caja", "ingresos", "gastos", "terminales", "canales", "apps", "sucursales"],
      "properties": {
        "periodo": {"type": "string", "format": "date"},
        "cortes": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "ventas": {"$ref": "#/$defs/importeCompat"},
        "resultado_caja": {"$ref": "#/$defs/importeCompat"},
        "ingresos": {"$ref": "#/$defs/importeCompat"},
        "gastos": {"$ref": "#/$defs/importeCompat"},
        "terminales": {"$ref": "#/$defs/importeCompat"},
        "canales": {"type": "object"},
        "apps": {"type": "object"},
        "sucursales": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "importeCompat": {
      "type": ["string", "integer", "number"],
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[ \\t]*[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[ \\t]*$",
      "minimum": -999999999999.99,
      "maximum": 999999999999.99
    }
  }
}